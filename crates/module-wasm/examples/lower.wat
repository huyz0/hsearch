(module
  (import "hsearch_host_v1" "log" (func $log (param i32 i32 i32)))
  (import "hsearch_host_v1" "cancelled" (func $cancelled (result i32)))
  (memory (export "memory") 3 3)
  (global $out_len (mut i32) (i32.const 0))
  ;; input region 0x1000..0x11000, output region 0x11000..0x21000, descriptor at 0x21000
  (data (i32.const 0x21000) "{\"name\":\"wasm-lower\",\"version\":\"0.1.0\",\"abi\":\"1.0\",\"engine_api\":\"1.0\",\"max_concurrent_calls\":2,\"io_bytes\":65536,\"extension_points\":[{\"kind\":\"analyzer\",\"id\":\"lowercase_ascii\",\"version\":\"1.0.0\",\"deterministic\":true}]}")
  (func (export "hs_abi_version") (result i32) (i32.const 0x10000))
  (func (export "hs_module_init") (param i32) (result i32) (i32.const 0))
  (func (export "hs_module_describe") (result i32)
    (memory.copy (i32.const 0x11000) (i32.const 0x21000) (i32.const 215))
    (global.set $out_len (i32.const 215))
    (i32.const 0))
  (func (export "hs_module_call") (param $kind i32) (param $plen i32) (param $ilen i32) (param $t i32) (result i32)
    (local $i i32) (local $c i32) (local $src i32)
    (local.set $src (i32.add (i32.const 0x1000) (local.get $plen)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $ilen)))
        (local.set $c (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (if (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
          (then (local.set $c (i32.add (local.get $c) (i32.const 32)))))
        (i32.store8 (i32.add (i32.const 0x11000) (local.get $i)) (local.get $c))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)))
    (global.set $out_len (local.get $ilen))
    (i32.const 0))
  (func (export "hs_module_shutdown"))
  (func (export "hs_input_region") (result i32) (i32.const 0x1000))
  (func (export "hs_output_region") (result i32) (i32.const 0x11000))
  (func (export "hs_output_len") (result i32) (global.get $out_len))
)
