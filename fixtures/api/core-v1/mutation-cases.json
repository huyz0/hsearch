[
  {
    "id": "stable-id-crud",
    "area": "A02",
    "profile_class": "subset",
    "intent": "matching_target",
    "setup": "empty",
    "steps": [
      {
        "request": {
          "method": "PUT",
          "path": "/{index}/_doc/stable",
          "json": {
            "uid": "stable",
            "tenant": "acct-a",
            "category": "book",
            "title": "Original public fixture",
            "price": 10,
            "active": true,
            "created_at": "2026-01-01T00:00:00Z"
          }
        },
        "expect": {
          "status": 201,
          "fields": {
            "/result": "created",
            "/_id": "stable"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "path": "/{index}/_doc/stable"
        },
        "expect": {
          "status": 200,
          "fields": {
            "/found": true,
            "/_source": {
              "uid": "stable",
              "tenant": "acct-a",
              "category": "book",
              "title": "Original public fixture",
              "price": 10,
              "active": true,
              "created_at": "2026-01-01T00:00:00Z"
            }
          }
        }
      },
      {
        "request": {
          "method": "PUT",
          "path": "/{index}/_doc/stable",
          "json": {
            "uid": "stable",
            "tenant": "acct-a",
            "category": "book",
            "title": "Replacement",
            "price": 20,
            "active": true,
            "created_at": "2026-01-01T00:00:00Z"
          }
        },
        "expect": {
          "status": 200,
          "fields": {
            "/result": "updated"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "path": "/{index}/_doc/stable"
        },
        "expect": {
          "status": 200,
          "fields": {
            "/found": true,
            "/_source": {
              "uid": "stable",
              "tenant": "acct-a",
              "category": "book",
              "title": "Replacement",
              "price": 20,
              "active": true,
              "created_at": "2026-01-01T00:00:00Z"
            }
          }
        }
      },
      {
        "request": {
          "method": "DELETE",
          "path": "/{index}/_doc/stable"
        },
        "expect": {
          "status": 200,
          "fields": {
            "/result": "deleted"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "path": "/{index}/_doc/stable"
        },
        "expect": {
          "status": 404,
          "fields": {
            "/found": false
          }
        }
      },
      {
        "request": {
          "method": "DELETE",
          "path": "/{index}/_doc/stable"
        },
        "expect": {
          "status": 404,
          "fields": {
            "/result": "not_found"
          }
        }
      }
    ],
    "native_target": "Stable identity and authoritative latest GET; native receipt/version extensions are separate."
  },
