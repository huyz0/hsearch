    {
      "id": "bulk-results-keep-submitted-order",
      "area": "A03",
      "dataset": true,
      "state": "enforced",
      "oracle": {
        "kind": "opensearch-docs",
        "ref": "https://docs.opensearch.org/latest/api-reference/document-apis/bulk/"
      },
      "reference_cases": [
        "bulk-repeated-id-order"
      ],
      "steps": [
        {
          "method": "POST",
          "path": "/orders/_bulk?refresh=true",
          "body_text": "{\"index\":{\"_id\":\"x1\"}}\n{\"title\":\"one\",\"tag\":\"a\",\"n\":11,\"ok\":true,\"at\":\"2026-02-01\"}\n{\"index\":{\"_id\":\"x1\"}}\n{\"title\":\"two\",\"tag\":\"b\",\"n\":12,\"ok\":true,\"at\":\"2026-02-01\"}\n{\"delete\":{\"_id\":\"x1\"}}\n{\"delete\":{\"_id\":\"ghost\"}}\n",
          "expect": {
            "status": 200,
            "body": {
              "errors": false,
              "items": [
                {
                  "index": {
                    "_id": "x1",
                    "status": 201,
                    "result": "created"
                  }
                },
                {
                  "index": {
                    "_id": "x1",
                    "status": 200,
                    "result": "updated"
                  }
                },
                {
                  "delete": {
                    "_id": "x1",
                    "status": 200,
                    "result": "deleted"
                  }
                },
                {
                  "delete": {
                    "_id": "ghost",
                    "status": 404,
                    "result": "not_found"
                  }
                }
              ]
            }
          }
        },
        {
          "method": "GET",
          "path": "/orders/_doc/x1",
          "expect": {
            "status": 404,
            "body": {
              "found": false
            }
          }
        }
      ]
    },
    {
      "id": "bulk-item-failure-does-not-erase-neighbours",
      "area": "A03",
      "dataset": true,
      "state": "enforced",
      "oracle": {
        "kind": "opensearch-docs",
        "ref": "https://docs.opensearch.org/latest/api-reference/document-apis/bulk/"
      },
      "reference_cases": [
        "bulk-semantic-isolation"
      ],
      "steps": [
        {
          "method": "POST",
          "path": "/orders/_bulk?refresh=true",
          "body_text": "{\"index\":{\"_id\":\"ok1\"}}\n{\"title\":\"fine\",\"tag\":\"a\",\"n\":21,\"ok\":true,\"at\":\"2026-02-01\"}\n{\"index\":{\"_id\":\"bad\"}}\n{\"title\":\"x\",\"tag\":\"a\",\"n\":22,\"ok\":true,\"at\":\"2026-02-01\",\"extra\":1}\n{\"index\":{\"_id\":\"ok2\"}}\n{\"title\":\"fine\",\"tag\":\"a\",\"n\":23,\"ok\":true,\"at\":\"2026-02-01\"}\n",
          "expect": {
            "status": 200,
            "body": {
              "errors": true,
              "items": [
                {
                  "index": {
                    "_id": "ok1",
                    "status": 201
                  }
                },
                {
                  "index": {
                    "_id": "bad",
                    "status": 400
                  }
                },
                {
                  "index": {
                    "_id": "ok2",
                    "status": 201
                  }
                }
              ]
            }
          }
        },
        {
          "method": "GET",
          "path": "/orders/_doc/bad",
          "expect": {
            "status": 404,
            "body": {
              "found": false
            }
          }
        },
        {
          "method": "GET",
          "path": "/orders/_doc/ok2",
          "expect": {
            "status": 200,
            "body": {
              "found": true
            }
          }
        }
      ]
    },
