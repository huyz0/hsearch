{
  "class": "reference",
  "meaning": "Behaviour OpenSearch documents and hsearch matches. The expectation is the documented OpenSearch result for the small dataset in dataset.json; reference_cases names a core-v1 case whose reference-run oracle covers the same behaviour. Nothing here was executed against an OpenSearch server by this corpus.",
  "cases": [
    {
      "id": "match-all-total",
      "area": "A08",
      "dataset": true,
      "state": "enforced",
      "oracle": {
        "kind": "opensearch-docs",
        "ref": "https://docs.opensearch.org/latest/api-reference/search-apis/search/"
      },
      "reference_cases": [
        "bounded-total-hit-relation"
      ],
      "steps": [
        {
          "method": "POST",
          "path": "/orders/_search",
          "body": {
            "query": {
              "match_all": {}
            },
            "size": 0
          },
          "expect": {
            "status": 200,
            "body": {
              "hits": {
                "total": {
                  "value": 8,
                  "relation": "eq"
                },
                "hits": []
              }
            }
          }
        }
      ]
    },
    {
