{
  "class": "unsupported",
  "meaning": "Requests outside the core-v1 profile. Each must be refused with a typed, non-5xx error that names the refusal, and must change nothing. temporary_until names the task that gives the feature a supported form; until it lands the refusal is the contract.",
  "cases": [
    {
      "id": "script-query-is-refused",
      "area": "A11",
      "dataset": true,
      "state": "enforced",
      "oracle": {
        "kind": "hsearch-profile",
        "ref": "docs/plan/api-compatibility.md#a11"
      },
      "steps": [
        {
          "method": "POST",
          "path": "/orders/_search",
          "body": {
            "query": {
              "script": {
                "script": {
                  "source": "doc['n'].value > 3"
                }
              }
            }
          },
          "expect": {
            "status": 400,
            "body": {
              "error": {
                "type": "parsing_exception"
              }
            }
          }
        },
        {
          "method": "POST",
          "path": "/orders/_search",
          "body": {
            "script_fields": {
              "x": {
                "script": {
                  "source": "1"
                }
              }
            }
          },
          "expect": {
            "status": 400,
            "body": {
              "error": {
                "type": "<any>"
              }
            }
          }
        }
      ]
    },
    {
      "id": "scripted-update-refuses-before-mutation",
      "area": "A11",
      "dataset": true,
      "state": "enforced",
      "oracle": {
        "kind": "hsearch-profile",
        "ref": "docs/plan/api-compatibility.md#a11"
      },
      "steps": [
        {
          "method": "POST",
          "path": "/orders/_update/d1",
          "body": {
            "script": {
              "source": "ctx._source.n += params.d",
              "params": {
                "d": 1
              }
            }
          },
          "expect": {
            "status_in": [
              400,
              404,
              405
            ],
            "body": {
              "error": {
                "type": "<any>"
              }
            }
          }
        },
        {
          "method": "GET",
          "path": "/orders/_doc/d1",
          "expect": {
            "status": 200,
            "body": {
              "_source": {
                "n": 1
              }
            }
          }
        }
      ]
    },
