{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hsearch task packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "goal", "base_revision", "owner_session", "owned_paths", "assumptions", "acceptance", "negative_cases", "commands", "output_budget_bytes", "expected_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^M[0-9]{2}\\.[0-9]{2}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4096},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner_session": {"type": "string", "minLength": 1, "maxLength": 200},
    "owned_paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "assumptions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "acceptance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "negative_cases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["prefetch", "diagnostics", "check", "probe"]}},
    "output_budget_bytes": {"type": "integer", "minimum": 4096, "maximum": 8388608},
    "expected_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  }
}
