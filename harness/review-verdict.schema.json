{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Independent session review verdict v1",
  "required": [
    "schema_version",
    "packet_sha256",
    "head",
    "tree",
    "source_digest",
    "role",
    "reviewer_session",
    "conclusion",
    "basis",
    "findings",
    "resolutions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "correctness_tests_claims",
        "architecture_security"
      ]
    },
    "reviewer_session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9/][A-Za-z0-9._:/-]*$"
    },
    "conclusion": {
      "enum": [
        "clear",
        "blocked"
      ]
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "file",
          "line",
          "reproduction",
          "expected",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "reproduction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_key",
          "evidence"
        ],
        "properties": {
          "review_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
